{
  "name": "prisma-analytics",
  "version": "1.0.0",
  "description": "Platform for financial diagnosis, ratio analysis, and automated executive reporting designed for auditors and financial experts.",
  "main": "backend/main.js",
  "scripts": {
    "start": "concurrently \"npm run start:frontend\" \"wait-on http://localhost:5173 && npm run start:electron\"",
    "start:frontend": "cd frontend && npm run dev",
    "start:electron": "cross-env NODE_ENV=development electron .",
    "build": "cd frontend && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
