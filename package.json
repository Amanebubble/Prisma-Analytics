  "devDependencies": {
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "sqlite3": "^6.0.1",
